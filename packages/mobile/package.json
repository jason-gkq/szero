{
  "name": "@szero/mobile",
  "version": "4.0.2",
  "description": "szero-mobile",
  "keywords": [
    "szero-mobile"
  ],
  "author": "guokeqin <guokeqin163@163.com>",
  "homepage": "https://github.com/jason-gkq/szero/tree/main/packages/mobile#readme",
  "license": "ISC",
  "main": "lib/index.js",
  "module": "es/index.js",
  "unpkg": "dist/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "build:dev": "rimraf dist es lib && cross-env NODE_ENV=development rollup -c rollup.config.js --bundleConfigAsCjs && tsc",
    "build:prod": "rimraf dist es lib && cross-env NODE_ENV=production rollup -c rollup.config.js --bundleConfigAsCjs && tsc",
    "tsc": "tsc",
    "test": "node ./__tests__/mobile.test.js"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "dist",
    "lib",
    "es"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "dist/*",
    "es/**/style/*",
    "lib/**/style/*",
    "*.less"
  ],
  "browserslist": [
    "iOS >= 10",
    "Android >= 10",
    "Firefox > 65",
    "chrome > 72",
    "safari >= 10",
    ">0.2%",
    "not dead",
    "last 2 versions",
    "not op_mini all"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jason-gkq/szero.git"
  },
  "bugs": {
    "url": "https://github.com/jason-gkq/szero/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
