{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "rootDir": "src",
    "outDir": "lib",

    "lib": ["DOM", "ESNext"],

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,

    "isolatedModules": true,
    "useDefineForClassFields": true,

    "declaration": true,
    "declarationMap": true,
    // "emitDeclarationOnly": true,

    "stripInternal": true,

    "jsx": "react-jsx",
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib", "dist", "es"]
}




