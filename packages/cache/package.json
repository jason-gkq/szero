{
  "name": "@szero/cache",
  "version": "4.0.0-alpha.0",
  "description": "缓存包处理",
  "keywords": [
    "szero-cache"
  ],
  "author": "guokeqin <guokeqin163@163.com>",
  "homepage": "https://github.com/jason-gkq/szero/tree/main/packages/cache#readme",
  "license": "ISC",
  "main": "lib/index.js",
  "module": "es/index.js",
  "unpkg": "dist/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "build:dev": "cross-env NODE_ENV=development rollup -c rollup.config.js --bundleConfigAsCjs && tsc",
    "build:prod": "cross-env NODE_ENV=production rollup -c rollup.config.js --bundleConfigAsCjs && tsc",
    "tsc": "tsc",
    "test": "node ./__tests__/cache.test.js"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "dist",
    "lib",
    "es"
  ],
  "engines": {
    "node": ">=14.17.0"
  },
  "sideEffects": [
    "dist/*",
    "es/**/style/*",
    "lib/**/style/*",
    "*.less"
  ],
  "browserslist": [
    "iOS >= 10",
    "Android >= 10",
    "Firefox > 65",
    "chrome > 72",
    "safari >= 10",
    ">0.2%",
    "not dead",
    "IE 11",
    "not IE 10",
    "last 2 versions",
    "not op_mini all"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jason-gkq/szero.git"
  },
  "bugs": {
    "url": "https://github.com/jason-gkq/szero/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-external-helpers": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime-corejs3": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^25.9.2",
    "core-js": "^3.49.0",
    "cross-env": "^10.1.0",
    "rollup": "^4.61.1",
    "rollup-plugin-clear": "^2.0.7",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-sourcemaps": "^0.6.3",
    "rollup-plugin-typescript2": "^0.37.0",
    "typescript": "^6.0.3"
  }
}
